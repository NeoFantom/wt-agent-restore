                        'Check how far you got and whether any output is incomplete, then continue the original task.'),
    # Sent to the session that ran `anti-thanos reboot` (if it is one of the agents). Empty disables.
    'self_prompt': ('[anti-thanos] The reboot is done. Run `anti-thanos verify`, check the result '
                    '(every tab, its title, every session resumed, interrupted ones continued), '
                    'and report back to the user.'),
    # A session counts as busy if its transcript was written within this many seconds.
    'busy_window_seconds': 180,
    # Before resuming, wait until these URLs answer (through the session's own proxy env).
    'network_check': {'claude': 'https://api.anthropic.com', 'codex': 'https://chatgpt.com'},
    'network_wait_seconds': 180,
    # If the agent exits within this many seconds of starting, retry (boot-time network races).
    'retry_if_exits_within': 30,
    'retries': 3,
    # Tab titles: "auto" pins titles that look hand-set, "always" pins every non-default title, "never".
    'titles': 'auto',
    # Windows Terminal profile used for restored tabs. null = the profile named after the WSL distro.
    'profile': None,
    # Rules that override the relaunch command. First match wins. See config.example.json.
    'rules': [],
}

# Environment variables replayed into the relaunched agent (names, regex). Secrets are never written.
ENV_KEEP = re.compile(r'^(CLAUDE_CONFIG_DIR|CODEX_HOME|TZ|https?_proxy|HTTPS?_PROXY|all_proxy|ALL_PROXY|no_proxy|NO_PROXY|'
                      r'ANTHROPIC_BASE_URL|ANTHROPIC_MODEL|ANTHROPIC_DEFAULT_\w+_MODEL|CLAUDE_CODE_(EXPERIMENTAL|USE|MAX|DISABLE|ENABLE)_\w+|OPENAI_BASE_URL)$')
ENV_SECRET = re.compile(r'(KEY|TOKEN|SECRET|PASSWORD|PASSWD|CREDENTIAL|AUTH)', re.I)
# Set by the agents themselves for their children; never replay.
ENV_INTERNAL = re.compile(r'^CLAUDE_CODE_(CHILD_SESSION|ENTRYPOINT|EXECPATH|SSE_PORT|SESSION_ID|IDE\w*|SHELL\w*)$|^CLAUDECODE$')
ENV_FOR = {'claude': re.compile(r'^(CLAUDE|ANTHROPIC)_'), 'codex': re.compile(r'^(CODEX|OPENAI)_')}
_BASELINE = None


def baseline_env():
    """Environment of a fresh interactive shell: only variables that differ from it were added by a wrapper."""
    global _BASELINE
    if _BASELINE is None:
        try:
            clean = {k: os.environ[k] for k in ('HOME', 'USER', 'LOGNAME', 'LANG', 'WSL_DISTRO_NAME', 'WSL_INTEROP',
                                                'WSLENV', 'DISPLAY', 'WAYLAND_DISPLAY') if k in os.environ}
            clean.update(SHELL=user_shell(), TERM='xterm-256color', PATH='/usr/local/bin:/usr/bin:/bin')
            r = subprocess.run([user_shell(), '-lic', 'env -0'], capture_output=True, timeout=30,
                               stdin=subprocess.DEVNULL, env=clean, cwd=HOME)
            _BASELINE = dict(x.decode(errors='replace').split('=', 1) for x in r.stdout.split(b'\0') if b'=' in x)
        except (OSError, subprocess.TimeoutExpired):
            _BASELINE = {}
    return _BASELINE


def replay_env(env, kind):
    base = baseline_env()
    other = ENV_FOR['codex' if kind == 'claude' else 'claude']
    return {k: v for k, v in env.items()
            if ENV_KEEP.match(k) and not ENV_SECRET.search(k) and not ENV_INTERNAL.match(k)
            and not other.match(k) and base.get(k) != v}

CLAUDE_VALUE_FLAGS = {
