#!/usr/bin/env python3
"""anti-thanos — reboot Windows and get your Claude Code / Codex sessions back.

Snapshot every live Claude Code / Codex session running in WSL inside Windows Terminal
(plus tmux-hosted ones), arm a one-shot logon hook, reboot, and get the same window back:
same tabs, same order, same tab titles, every agent resumed in its own directory, and
interrupted agents told what happened so they can pick up where they left off.

Commands:
  snapshot        record sessions + tab layout and print the restore plan
  preview         open a throwaway WT window showing what each tab would run (nothing resumes)
  arm             snapshot + install the one-shot restore hook (no reboot)
  disarm          remove the hook
  reboot          [wait for an installer] -> arm -> stop agents gracefully -> restart Windows
  verify          after the reboot: check every recorded session is running again
  status          show hook state and the last snapshot

Linux side: Python 3.9+ stdlib only. Windows side: PowerShell 5.1 + Windows Terminal.
https://github.com/NeoFantom/anti-thanos   MIT License
"""
import argparse
import glob
import json
import os
import re
import shlex
import shutil
import subprocess
import sys
import time

