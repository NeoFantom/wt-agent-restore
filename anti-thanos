    '--setting-sources', '--betas', '--output-format', '--input-format', '--permission-prompt-tool', '--max-turns',
    '--effort', '--name', '--worktree', '-w', '--debug-file', '--remote-control-session-name-prefix',
}
CLAUDE_DROP_FLAGS = {'-c', '--continue', '-p', '--print', '--fork-session'}
CLAUDE_DROP_VALUE_FLAGS = {'-r', '--resume', '--session-id', '--from-pr'}
CODEX_VALUE_FLAGS = {'-c', '--config', '-m', '--model', '-p', '--profile', '-s', '--sandbox', '-a', '--ask-for-approval',
